# ============================================================
#  MANCERA ATELIER — variables de entorno
#  Copia estos nombres en Vercel → Settings → Environment Variables
#  NUNCA subas este archivo con valores reales a GitHub.
# ============================================================

# --- Resend -------------------------------------------------
# Crea la clave en https://resend.com/api-keys (permiso: Full access)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente. El dominio debe estar VERIFICADO en Resend.
CORREO_REMITENTE=Mancera Atelier <hola@manceracol.com>
CORREO_RESPUESTA=hola@manceracol.com

# Ya existen en tu cuenta — no los cambies salvo que crees otros:
RESEND_SEGMENT_ID=76f321d9-e38a-41f5-bd34-33cbe1830ae3
RESEND_TOPIC_ID=40740b96-648a-49de-b2c9-bcb4e7fbf92f

# --- Base de datos (Upstash Redis) --------------------------
# Vercel → Storage → Marketplace → Upstash → Redis.
# Al conectarla, Vercel inyecta estas dos variables automáticamente.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# --- Descuentos ---------------------------------------------
# Código maestro: fijo, sin vencimiento, sin límite de uso.
CODIGO_MAESTRO=MANCERA20
DESCUENTO_MAESTRO=0.20

# Código de bienvenida: único por persona.
DESCUENTO_BIENVENIDA=0.10
DIAS_VIGENCIA_BIENVENIDA=5

# --- Mercado Pago -------------------------------------------
# Credenciales de producción: https://www.mercadopago.com.co/developers/panel/app
# El access token NO debe aparecer nunca en el navegador ni en el repositorio.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# La public key sí es pública: va escrita en index.html (CONFIG.mercadoPago).
# Se deja aquí solo como referencia.
# MP_PUBLIC_KEY=APP_USR-8a48ece6-0ed0-4937-b8fe-c4e2c1a87adc

# El client id y el client secret son para OAuth de marketplace.
# Esta tienda NO los necesita: no los subas a ningún lado.

# --- Seguridad ----------------------------------------------
# Inventa una cadena larga y aleatoria. Protege los endpoints de cron.
CRON_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Dominio público del sitio (sin barra final).
SITIO_URL=https://manceracol.com
